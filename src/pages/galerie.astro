---
import Layout from "../layouts/Layout.astro";
import Icon from "../components/Icon.astro";

const base = import.meta.env.BASE_URL.replace(/\/$/, "");

const photos = [
  { src: "/images/weide.jpg", caption: "Weide", wide: true },
  { src: "/images/weide2.jpg", caption: "Weide" },
  { src: "/images/ausritt.jpg", caption: "Ausritt" },
  { src: "/images/ponyclub.jpg", caption: "Ponyclub" },
  { src: "/images/ponys.jpg", caption: "Ponys" },
  { src: "/images/reitstunde.jpg", caption: "Reitstunde" },
  { src: "/images/voltige.jpg", caption: "Voltige" },
  { src: "/images/reitlager.jpg", caption: "Reitlager" },
  { src: "/images/reitlager2.png", caption: "Reitlager" },
  { src: "/images/reitstunde.png", caption: "Reitstunde" },
];
---

<Layout
  title="Galerie | Martin's Reithof"
  description="Impressionen vom Martin's Reithof in Zürich-Rümlang – Ponyreiten, Ausritte, Ponyclub und Reitlager."
>
  <section class="page-hero">
    <div class="container">
      <span class="eyebrow" style="color:var(--cream)">
        <Icon name="horseshoe" size={15} /> Galerie
      </span>
      <h1>Momente vom Hof</h1>
      <p>
        Impressionen vom Reiten, Spielen und Spass auf Martin's Reithof.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="gallery">
        {photos.map((photo) => (
          <figure class={`gallery__item${photo.wide ? " gallery__item--wide" : ""}`}>
            <img
              src={`${base}${photo.src}`}
              alt={`${photo.caption} – Martin's Reithof`}
              loading="lazy"
            />
            <figcaption>{photo.caption}</figcaption>
          </figure>
        ))}
      </div>

      <a class="back-link" href={`${base}/`}>
        <Icon name="arrowLeft" size={18} />
        Zurück zur Startseite
      </a>
    </div>
  </section>
</Layout>
