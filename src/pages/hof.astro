---
import Layout from "../layouts/Layout.astro";
import Icon from "../components/Icon.astro";

const base = import.meta.env.BASE_URL.replace(/\/$/, "");

const photos = [
  { src: "/images/hof/reistall.webp", caption: "Reitstall" },
  { src: "/images/hof/reitplatz.webp", caption: "Reitplatz" },
];
---

<Layout
  title="Hof | Martin's Reithof"
  description="Impressionen vom Martin's Reithof in Zürich-Rümlang – Ponyreiten, Ausritte, Ponyclub und Reitlager."
>
  <section class="page-hero">
    <div class="container">
      <span class="eyebrow" style="color:var(--cream)">
        <Icon name="horseshoe" size={15} /> Hof
      </span>
      <h1>Impressionen vom Hof</h1>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="gallery">
        {photos.map((photo) => (
          <figure class="gallery__item">
            <img
              src={`${base}${photo.src}`}
              alt={`${photo.caption} – Martin's Reithof`}
              loading="lazy"
            />
          </figure>
        ))}
      </div>

      <a class="back-link" href={`${base}/`}>
        <Icon name="arrowLeft" size={18} />
        Zurück zur Startseite
      </a>
    </div>
  </section>
</Layout>
