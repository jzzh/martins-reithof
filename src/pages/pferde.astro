---
import Layout from "../layouts/Layout.astro";
import Icon from "../components/Icon.astro";

const base = import.meta.env.BASE_URL.replace(/\/$/, "");

const horses = [
  "Antje",
  "Asterix",
  "Ballerina",
  "Bella",
  "Donna",
  "Ellay",
  "Enzo",
  "Flitz",
  "Folie",
  "Hawaii",
  "Heiko",
  "Idefix",
  "Jana",
  "Kilusha",
  "Lucille",
  "Luna",
  "Nancy",
  "Nora",
  "Norina",
  "Obelix",
  "Primrose",
  "Princess",
  "Sarah",
  "Texas",
];
---

<Layout
  title="Unsere Pferde | Martin's Reithof"
  description="Lerne die Pferde und Ponys von Martin's Reithof in Zürich-Rümlang in unserer Fotogalerie kennen."
>
  <section class="page-hero">
    <div class="container">
      <span class="eyebrow" style="color:var(--cream)">
        <Icon name="horseshoe" size={15} /> Unsere Pferde
      </span>
      <h1>Unsere Pferde</h1>
      <p>Lerne die Pferde und Ponys vom Martin's Reithof kennen.</p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="gallery horse-gallery">
        {horses.map((name) => (
          <figure class="gallery__item">
            <img
              src={`${base}/images/Pferde/${name}.webp`}
              alt={`${name} vom Martin's Reithof`}
              loading="lazy"
              decoding="async"
            />
          </figure>
        ))}
      </div>

      <a class="back-link" href={`${base}/`}>
        <Icon name="arrowLeft" size={18} />
        Zurück zur Startseite
      </a>
    </div>
  </section>
</Layout>

<style>
  .horse-gallery {
    grid-template-columns: 1fr;
  }

  .horse-gallery .gallery__item {
    align-self: start;
    aspect-ratio: auto;
  }

  .horse-gallery .gallery__item img {
    width: 100%;
    height: auto;
    object-fit: contain;
  }

  @media (min-width: 700px) {
    .horse-gallery {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
</style>
